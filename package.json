{
  "name": "deep-learning-study-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/export-static.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "build": "node scripts/export-static.mjs && tsc --noEmit && vite build",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "prepare:slides": "python -X utf8 scripts/prepare_slides.py && python -X utf8 scripts/render_pages.py",
    "prepare:bank": "python -X utf8 scripts/build_bank.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {"react": "^19.0.0", "react-dom": "^19.0.0", "katex": "^0.16.0", "lucide-react": "^0.468.0"},
  "devDependencies": {"@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@types/node": "^24.0.0", "typescript": "^5.7.0", "vite": "^6.0.0", "@vitejs/plugin-react": "^4.3.0", "@playwright/test": "^1.50.0"}
}
